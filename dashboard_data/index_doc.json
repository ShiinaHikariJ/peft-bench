{"text": "<meta name=\"dash-one-writer\">\n<style>\n  .pb { display: flex; flex-direction: column; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans); max-width: 78rem; margin-inline: auto; }\n  .pb-head { display: flex; flex-direction: column; gap: var(--cds-gap-sm); }\n  .pb-title { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n  .pb-lede { margin: 0; max-width: 62rem; color: var(--color-fg); font-size: var(--cds-font-size-body); line-height: 1.6; }\n  .pb-sub { margin: 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .pb b { font-weight: 600; font-variant-numeric: tabular-nums; }\n  .pb-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: var(--cds-gap-md); }\n  .pb-tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-xs); min-width: 0; }\n  .pb-tile-label { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .pb-tile-value { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; line-height: 1.15; }\n  .pb-tile-note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .pb-section { display: flex; flex-direction: column; gap: var(--cds-gap-md); }\n  .pb-h2 { margin: 0; font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); }\n  .pb-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: var(--cds-gap-md); }\n  .pb-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-sm); min-width: 0; }\n  .pb-card-title { margin: 0; font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); }\n  .pb-note { margin: 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); line-height: 1.5; }\n  .pb-chart { position: relative; width: 100%; min-height: 26rem; }\n  .pb-chart.pb-short { min-height: 22rem; }\n  .pb-chart svg { display: block; overflow: visible; }\n  .pb-chart text { font-family: var(--font-anthropic-sans); font-size: var(--cds-font-size-caption); fill: var(--color-fg-muted); }\n  .pb-chart .pb-lbl { fill: var(--color-fg); }\n  .pb-legend { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs) var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .pb-legend li { display: inline-flex; align-items: center; gap: var(--cds-gap-xs); }\n  .pb-sw { width: 0.75rem; height: 0.75rem; border-radius: 2px; display: inline-block; background: var(--cds-chart-muted); }\n  .pb-tip { position: absolute; z-index: 5; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); display: flex; flex-direction: column; gap: 2px; min-width: 11rem; max-width: 16rem; }\n  .pb-tip .pb-tip-head { color: var(--cds-text-secondary); }\n  .pb-tip .pb-tip-row { display: flex; justify-content: space-between; gap: var(--cds-gap-sm); font-variant-numeric: tabular-nums; }\n  .pb-fail { display: flex; align-items: center; justify-content: center; gap: var(--cds-gap-xs); min-height: inherit; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .pb-fail::before { content: \"\"; width: 0.375rem; height: 0.375rem; border-radius: 50%; background: var(--color-bad); }\n  .pb-tablebox { overflow: auto; max-height: 34rem; }\n  .pb-table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n  .pb-table th, .pb-table td { padding: var(--cds-pad-xs) var(--cds-pad-sm); text-align: right; white-space: nowrap; border-bottom: 1px solid var(--color-border-line); }\n  .pb-table th:first-child, .pb-table td:first-child, .pb-table .pb-left { text-align: left; }\n  .pb-table th { position: sticky; top: 0; background: var(--color-panel); color: var(--color-fg-muted); font-weight: var(--cds-font-weight-medium); z-index: 1; }\n  .pb-sort { all: unset; cursor: pointer; }\n  .pb-sort:focus-visible { outline: 2px solid var(--cds-chart-axis); outline-offset: 2px; }\n  .pb-sort::after { content: \"\"; display: inline-block; width: 0.8em; }\n  th[aria-sort=\"descending\"] .pb-sort::after { content: \" ↓\"; }\n  th[aria-sort=\"ascending\"] .pb-sort::after { content: \" ↑\"; }\n  .pb-bar { position: relative; }\n  .pb-bar span { position: relative; }\n  .pb-bar::before { content: \"\"; position: absolute; left: var(--cds-pad-xs); top: 22%; bottom: 22%; width: calc(var(--w, 0) * (100% - 2 * var(--cds-pad-xs))); background: var(--bar-c, var(--cds-chart-muted)); opacity: .28; border-radius: 2px; }\n  .pb-findings { margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: var(--cds-gap-sm); max-width: 62rem; line-height: 1.65; }\n  .pb-findings li::marker { color: var(--color-fg-muted); }\n  .pb-plain { margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: var(--cds-gap-xs); line-height: 1.6; max-width: 62rem; }\n  [data-dash-source-state=empty] { color: transparent; }\n  [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n  @media (max-width: 720px) { .pb-sec { display: none; } }\n</style>\n\n<div class=\"pb\">\n  <header class=\"pb-head\" id=\"top\">\n    <h1 class=\"pb-title\">PEFT 微调方法评测</h1>\n    <p class=\"pb-lede\">在 Qwen2.5-1.5B 上，参数高效微调普遍追平甚至超过全参数微调：常识推理最高 <b data-draw=\"num\" data-source=\"best\" data-where=\"task=commonsense\" data-field=\"score\" data-fmt=\"2\">—</b>（<span data-draw=\"num\" data-source=\"best\" data-where=\"task=commonsense\" data-field=\"method_label\" data-fmt=\"text\">—</span>），GSM8K 最高 <b data-draw=\"num\" data-source=\"best\" data-where=\"task=math\" data-field=\"score\" data-fmt=\"2\">—</b>（<span data-draw=\"num\" data-source=\"best\" data-where=\"task=math\" data-field=\"method_label\" data-fmt=\"text\">—</span>，只训练 <span data-draw=\"num\" data-source=\"best\" data-where=\"task=math\" data-field=\"trainable_pct\" data-fmt=\"3\">—</span>% 的参数）；Full FT 分别为 <b data-draw=\"num\" data-source=\"results\" data-where=\"task=commonsense&amp;method=full\" data-field=\"score\" data-fmt=\"2\">—</b> 和 <b data-draw=\"num\" data-source=\"results\" data-where=\"task=math&amp;method=full\" data-field=\"score\" data-fmt=\"2\">—</b>。若只选一种，LoRA 在效果、速度和显存之间最均衡。</p>\n    <p class=\"pb-sub\">17 种方法 × 2 个任务，单卡 RTX 4090，2026 年 10 月。分数为准确率（%）。</p>\n  </header>\n\n  <div class=\"pb-tiles\">\n    <div class=\"pb-tile\">\n      <span class=\"pb-tile-label\">常识推理最高分</span>\n      <span class=\"pb-tile-value\" data-draw=\"num\" data-source=\"best\" data-where=\"task=commonsense\" data-field=\"score\" data-fmt=\"2\">—</span>\n      <span class=\"pb-tile-note\" data-draw=\"num\" data-source=\"best\" data-where=\"task=commonsense\" data-field=\"method_label\" data-fmt=\"text\">—</span>\n    </div>\n    <div class=\"pb-tile\">\n      <span class=\"pb-tile-label\">GSM8K 最高分</span>\n      <span class=\"pb-tile-value\" data-draw=\"num\" data-source=\"best\" data-where=\"task=math\" data-field=\"score\" data-fmt=\"2\">—</span>\n      <span class=\"pb-tile-note\" data-draw=\"num\" data-source=\"best\" data-where=\"task=math\" data-field=\"method_label\" data-fmt=\"text\">—</span>\n    </div>\n    <div class=\"pb-tile\">\n      <span class=\"pb-tile-label\">LoRA · 常识 / GSM8K</span>\n      <span class=\"pb-tile-value\"><span data-draw=\"num\" data-source=\"results\" data-where=\"task=commonsense&amp;method=lora\" data-field=\"score\" data-fmt=\"2\">—</span> / <span data-draw=\"num\" data-source=\"results\" data-where=\"task=math&amp;method=lora\" data-field=\"score\" data-fmt=\"2\">—</span></span>\n      <span class=\"pb-tile-note\">显存峰值 <span data-draw=\"num\" data-source=\"results\" data-where=\"task=math&amp;method=lora\" data-field=\"peak_mem_gb\" data-fmt=\"1\">—</span> GB（数学任务）</span>\n    </div>\n    <div class=\"pb-tile\">\n      <span class=\"pb-tile-label\">Full FT · 常识 / GSM8K</span>\n      <span class=\"pb-tile-value\"><span data-draw=\"num\" data-source=\"results\" data-where=\"task=commonsense&amp;method=full\" data-field=\"score\" data-fmt=\"2\">—</span> / <span data-draw=\"num\" data-source=\"results\" data-where=\"task=math&amp;method=full\" data-field=\"score\" data-fmt=\"2\">—</span></span>\n      <span class=\"pb-tile-note\">显存峰值 <span data-draw=\"num\" data-source=\"results\" data-where=\"task=math&amp;method=full\" data-field=\"peak_mem_gb\" data-fmt=\"1\">—</span> GB（数学任务）</span>\n    </div>\n    <div class=\"pb-tile\">\n      <span class=\"pb-tile-label\">基座（不微调）· 常识 / GSM8K</span>\n      <span class=\"pb-tile-value\"><span data-draw=\"num\" data-source=\"results\" data-where=\"task=commonsense&amp;method=base\" data-field=\"score\" data-fmt=\"2\">—</span> / <span data-draw=\"num\" data-source=\"results\" data-where=\"task=math&amp;method=base\" data-field=\"score\" data-fmt=\"2\">—</span></span>\n      <span class=\"pb-tile-note\">下限对照</span>\n    </div>\n  </div>\n\n  <section class=\"pb-section\" id=\"scores\">\n    <h2 class=\"pb-h2\">效果对比</h2>\n    <ul class=\"pb-legend\">\n      <li data-family=\"LoRA 系\"><span class=\"pb-sw\"></span>LoRA 系</li>\n      <li data-family=\"全参数\"><span class=\"pb-sw\"></span>全参数</li>\n      <li data-family=\"选择性\"><span class=\"pb-sw\"></span>选择性（Freeze）</li>\n      <li data-family=\"正交类\"><span class=\"pb-sw\"></span>正交类</li>\n      <li data-family=\"缩放类\"><span class=\"pb-sw\"></span>缩放类</li>\n      <li data-family=\"软提示\"><span class=\"pb-sw\"></span>软提示</li>\n      <li data-family=\"对照\"><span class=\"pb-sw\"></span>基座</li>\n    </ul>\n    <div class=\"pb-grid\">\n      <div class=\"pb-card\" id=\"chart-cs\">\n        <h3 class=\"pb-card-title\">常识推理（8 项平均）</h3>\n        <p class=\"pb-note\">虚线为未微调基座。LoRA、DoRA、rsLoRA、OFT、QLoRA 挤在最前面，差距在单种子误差内。</p>\n        <div class=\"pb-chart dash-skeleton\" data-draw=\"bars\" data-task=\"commonsense\" data-source=\"results\"></div>\n      </div>\n      <div class=\"pb-card\" id=\"chart-math\">\n        <h3 class=\"pb-card-title\">GSM8K</h3>\n        <p class=\"pb-note\">基座本身已有较强数学能力，各方法差距更小；参数极少的 VeRA、LoKr、IA³ 也排在前列。</p>\n        <div class=\"pb-chart dash-skeleton\" data-draw=\"bars\" data-task=\"math\" data-source=\"results\"></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"pb-section\" id=\"efficiency\">\n    <h2 class=\"pb-h2\">参数量与效果</h2>\n    <div class=\"pb-grid\">\n      <div class=\"pb-card\">\n        <h3 class=\"pb-card-title\">常识推理：可训练参数 vs 得分</h3>\n        <p class=\"pb-note\">横轴为对数刻度。LoRA、QLoRA、rsLoRA、PiSSA、LoRA+ 参数量相同，叠在一处，悬停可查看。</p>\n        <div class=\"pb-chart pb-short dash-skeleton\" data-draw=\"scatter\" data-task=\"commonsense\" data-source=\"results\"></div>\n      </div>\n      <div class=\"pb-card\">\n        <h3 class=\"pb-card-title\">GSM8K：可训练参数 vs 得分</h3>\n        <p class=\"pb-note\">数学任务上，参数量少两到三个数量级的方法也能达到 LoRA 的水平。</p>\n        <div class=\"pb-chart pb-short dash-skeleton\" data-draw=\"scatter\" data-task=\"math\" data-source=\"results\"></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"pb-section\" id=\"table\">\n    <h2 class=\"pb-h2\">完整结果</h2>\n    <div class=\"pb-card\">\n      <p class=\"pb-note\">点击表头排序。显存为训练时 PyTorch 分配的峰值；训练时间不含评测。窄屏时隐藏部分列。</p>\n      <div class=\"pb-tablebox\">\n        <table class=\"pb-table\" data-source=\"wide\" data-row-key=\"method\">\n          <thead>\n            <tr>\n              <th data-field=\"method_label\"><button type=\"button\" class=\"pb-sort\" data-key=\"method_label\">方法</button></th>\n              <th data-field=\"family\" class=\"pb-left pb-sec\"><button type=\"button\" class=\"pb-sort\" data-key=\"family\">类别</button></th>\n              <th data-field=\"trainable_m\"><button type=\"button\" class=\"pb-sort\" data-key=\"trainable_m\">可训练参数（M）</button></th>\n              <th data-field=\"trainable_pct\" class=\"pb-sec\"><button type=\"button\" class=\"pb-sort\" data-key=\"trainable_pct\">占比（%）</button></th>\n              <th data-field=\"lr\" class=\"pb-sec\"><button type=\"button\" class=\"pb-sort\" data-key=\"lr\">学习率</button></th>\n              <th data-field=\"cs_score\" aria-sort=\"descending\"><button type=\"button\" class=\"pb-sort\" data-key=\"cs_score\">常识推理</button></th>\n              <th data-field=\"math_score\"><button type=\"button\" class=\"pb-sort\" data-key=\"math_score\">GSM8K</button></th>\n              <th data-field=\"cs_mem\" class=\"pb-sec\"><button type=\"button\" class=\"pb-sort\" data-key=\"cs_mem\">显存 常识（GB）</button></th>\n              <th data-field=\"math_mem\"><button type=\"button\" class=\"pb-sort\" data-key=\"math_mem\">显存 数学（GB）</button></th>\n              <th data-field=\"cs_min\" class=\"pb-sec\"><button type=\"button\" class=\"pb-sort\" data-key=\"cs_min\">训练 常识（分钟）</button></th>\n              <th data-field=\"math_min\" class=\"pb-sec\"><button type=\"button\" class=\"pb-sort\" data-key=\"math_min\">训练 数学（分钟）</button></th>\n            </tr>\n          </thead>\n          <tbody data-draw=\"wide-body\"></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"pb-section\" id=\"detail\">\n    <h2 class=\"pb-h2\">常识推理分项</h2>\n    <div class=\"pb-card\">\n      <p class=\"pb-note\">颜色越深表示该列得分越高（按列各自比较）。Prefix 系列在几乎所有分项上低于基座。</p>\n      <div class=\"pb-tablebox\">\n        <table class=\"pb-table\" data-source=\"cs_detail\" data-row-key=\"method\">\n          <thead>\n            <tr>\n              <th data-field=\"method_label\">方法</th>\n              <th data-field=\"BoolQ\">BoolQ</th>\n              <th data-field=\"PIQA\">PIQA</th>\n              <th data-field=\"SIQA\">SIQA</th>\n              <th data-field=\"HellaSwag\">HellaSwag</th>\n              <th data-field=\"WinoGrande\">WinoGrande</th>\n              <th data-field=\"ARC-e\">ARC-e</th>\n              <th data-field=\"ARC-c\">ARC-c</th>\n              <th data-field=\"OBQA\">OBQA</th>\n              <th data-field=\"avg\">平均</th>\n            </tr>\n          </thead>\n          <tbody data-draw=\"heat-body\"></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"pb-section\" id=\"findings\">\n    <h2 class=\"pb-h2\">主要发现</h2>\n    <ol class=\"pb-findings\">\n      <li><b>LoRA 系最稳，几种变体差距很小。</b>LoRA、DoRA、rsLoRA、QLoRA、OFT 的常识推理得分在 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"top_cs_min\" data-fmt=\"2\">—</span>–<span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"top_cs_max\" data-fmt=\"2\">—</span> 之间，GSM8K 在 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"top_math_min\" data-fmt=\"2\">—</span>–<span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"top_math_max\" data-fmt=\"2\">—</span> 之间。比基座分别提升 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"lora_gain_cs\" data-fmt=\"1\">—</span> 和 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"lora_gain_math\" data-fmt=\"1\">—</span> 分（以 LoRA 计）。</li>\n      <li><b>DoRA 没有带来可见提升，训练却慢很多。</b>常识推理与 LoRA 同分，GSM8K 只高 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"dora_gain_math\" data-fmt=\"2\">—</span> 分，训练时间是 LoRA 的 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"dora_time_cs\" data-fmt=\"1\">—</span> 倍（常识）和 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"dora_time_math\" data-fmt=\"1\">—</span> 倍（数学）。</li>\n      <li><b>QLoRA 精度几乎无损，但在 1.5B 规模上基本不省显存。</b>常识推理只比 LoRA 低 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"qlora_drop_cs\" data-fmt=\"2\">—</span> 分；显存峰值只少 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"qlora_mem_cs\" data-fmt=\"2\">—</span> GB（常识）和 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"qlora_mem_math\" data-fmt=\"2\">—</span> GB（数学），训练反而慢 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"qlora_slow_cs\" data-fmt=\"0\">—</span>%。小模型的显存主要被激活值占用，4-bit 只压缩权重；到 7B 以上权重占比变大，QLoRA 的优势才会明显。</li>\n      <li><b>Full FT 反而低于 LoRA。</b>常识推理低 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"full_gap_cs\" data-fmt=\"2\">—</span> 分，GSM8K 低 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"full_gap_math\" data-fmt=\"2\">—</span> 分，显存峰值 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"full_mem_math\" data-fmt=\"1\">—</span> GB。在小数据、单 epoch 的设置下，全参数更新更容易冲掉原有能力；另外为了放进单卡，Full FT 使用了 8-bit AdamW。</li>\n      <li><b>极少参数的方法在数学上很强，在常识推理上明显掉分。</b>VeRA 只训练 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"vera_pct\" data-fmt=\"3\">—</span>% 的参数，GSM8K 拿到 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"vera_math\" data-fmt=\"2\">—</span>，但常识推理只有 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"vera_cs\" data-fmt=\"2\">—</span>；IA³（<span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"ia3_math\" data-fmt=\"2\">—</span> / <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"ia3_cs\" data-fmt=\"2\">—</span>）和 LoKr（<span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"lokr_math\" data-fmt=\"2\">—</span> / <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"lokr_cs\" data-fmt=\"2\">—</span>）同样如此。基座数学已有 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"base_math\" data-fmt=\"2\">—</span> 分，微调主要在教格式和解题风格；常识选择题需要更多可调容量。</li>\n      <li><b>Prefix 系列在常识推理上失败。</b>Prefix-Tuning (MLP) 只有 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"pmlp_cs\" data-fmt=\"2\">—</span>，P-Tuning v2 只有 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"prefix_cs\" data-fmt=\"2\">—</span>，低于基座。我们用三种解码方式核对过，结果一致：模型学会了答题格式，却几乎总选第一个选项，并非评测程序的问题。同一方法在 GSM8K 上仍有 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"pmlp_math\" data-fmt=\"2\">—</span>。Prompt Tuning 居中（<span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"prompt_cs\" data-fmt=\"2\">—</span> / <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"prompt_math\" data-fmt=\"2\">—</span>）。</li>\n      <li><b>PiSSA 的差距可能来自学习率。</b>按论文用 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"pissa_lr\" data-fmt=\"exp\">—</span>，是 LoRA（<span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"lora_lr\" data-fmt=\"exp\">—</span>）的十分之一，常识推理低 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"pissa_gap_cs\" data-fmt=\"2\">—</span> 分；GSM8K 与 LoRA 接近。值得用相同学习率补跑一次。</li>\n      <li><b>AdaLoRA 与 Freeze 不占优。</b>AdaLoRA 常识推理 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"ada_cs\" data-fmt=\"2\">—</span>，低于 LoRA；Freeze 只训练最后两层，GSM8K 只有 <span data-draw=\"num\" data-source=\"facts\" data-row=\"0\" data-field=\"freeze_math\" data-fmt=\"2\">—</span>，低于未微调的基座。</li>\n    </ol>\n  </section>\n\n  <section class=\"pb-section\" id=\"setup\">\n    <h2 class=\"pb-h2\">实验设置</h2>\n    <div class=\"pb-card\">\n      <div class=\"pb-tablebox\">\n        <table class=\"pb-table\" data-source=\"setup\" data-row-key=\"item\">\n          <thead><tr><th data-field=\"item\">项目</th><th data-field=\"value\" class=\"pb-left\">设置</th></tr></thead>\n          <tbody data-draw=\"setup-body\"></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"pb-section\" id=\"limits\">\n    <h2 class=\"pb-h2\">局限与下一步</h2>\n    <ul class=\"pb-plain\">\n      <li>每组实验只跑了一个随机种子，相差 0.5 分以内的方法不宜区分高下。</li>\n      <li>学习率取各方法的推荐默认值，未逐一调参；PiSSA、LoRA+、Prefix 系列对学习率敏感，结论可能随调参改变。</li>\n      <li>只测了 1.5B 模型和两个任务。QLoRA、Full FT 的显存与效果对比在 7B 以上可能明显不同。</li>\n      <li>AdaLoRA 的训练损失包含正交正则项，不能与其他方法的损失直接比较。</li>\n      <li>下一步建议：主要方法补 3 个种子；对 PiSSA、LoRA+、Prefix 做学习率扫描；增加代码任务（HumanEval / MBPP）；在 48GB 以上显卡上用 7B 模型复测核心方法。</li>\n    </ul>\n  </section>\n</div>\n\n<script>\n  // shared helpers: family colors, number formatting, row lookup by data-where / data-row\n  window.pbFamilies = ['LoRA 系', '全参数', '选择性', '正交类', '缩放类', '软提示', '对照'];\n  window.pbColor = (family) => {\n    const i = window.pbFamilies.indexOf(family);\n    return family === '对照' || i < 0 ? 'var(--cds-chart-muted)' : dash.colors[i % dash.colors.length];\n  };\n  window.pbFmt = (v, f) => {\n    if (v === null || v === undefined || v === '') return '—';\n    if (f === 'text') return String(v);\n    const n = Number(v);\n    if (Number.isNaN(n)) return '—';\n    if (f === 'exp') return n.toExponential(0).replace('e-', 'e-');\n    return n.toFixed(f === undefined ? 2 : +f);\n  };\n  window.pbPick = (el) => {\n    const d = dash.data(el.dataset.source);\n    if (d.status !== 'ok') return null;\n    const rows = Array.isArray(d.data) ? d.data : [];\n    if (el.dataset.row !== undefined) return rows[+el.dataset.row] ?? null;\n    const w = el.dataset.where;\n    if (!w) return rows[0] ?? null;\n    const conds = w.split('&').map((s) => s.split('=').map(decodeURIComponent));\n    return rows.find((r) => conds.every(([k, v]) => String(r[k]) === v)) ?? null;\n  };\n  window.pbFail = (el, d) => {\n    if (d.status === 'error' || d.status === 'connect' || d.status === 'declined') {\n      const f = document.createElement('div');\n      f.className = 'pb-fail';\n      f.textContent = '加载失败';\n      el.append(f);\n    }\n  };\n  window.pbTip = (el) => {\n    const tip = document.createElement('div');\n    tip.className = 'pb-tip';\n    tip.hidden = true;\n    el.append(tip);\n    return {\n      show(head, lines, x, y) {\n        const h = document.createElement('div');\n        h.className = 'pb-tip-head';\n        h.textContent = head;\n        const rows = lines.map(([k, v]) => {\n          const r = document.createElement('div');\n          r.className = 'pb-tip-row';\n          const a = document.createElement('span');\n          a.textContent = k;\n          const b = document.createElement('span');\n          b.textContent = v;\n          r.append(a, b);\n          return r;\n        });\n        tip.replaceChildren(h, ...rows);\n        tip.hidden = false;\n        const W = el.clientWidth, tw = tip.offsetWidth, th = tip.offsetHeight;\n        let left = x + 12, top = y - th / 2;\n        if (left + tw > W) left = x - tw - 12;\n        tip.style.left = Math.max(0, left) + 'px';\n        tip.style.top = Math.max(0, Math.min(top, el.clientHeight - th)) + 'px';\n      },\n      hide() { tip.hidden = true; },\n    };\n  };\n  window.pbTipLines = (r) => [\n    ['类别', r.family],\n    ['得分', window.pbFmt(r.score, 2)],\n    ['可训练参数', r.trainable_m ? window.pbFmt(r.trainable_m, 2) + ' M（' + window.pbFmt(r.trainable_pct, 3) + '%）' : '—'],\n    ['显存峰值', r.peak_mem_gb != null ? window.pbFmt(r.peak_mem_gb, 1) + ' GB' : '—'],\n    ['训练时间', r.train_min != null ? window.pbFmt(r.train_min, 1) + ' 分钟' : '—'],\n  ];\n\n  document.querySelectorAll('.pb-legend [data-family]').forEach((li) => {\n    li.querySelectorAll('.pb-sw').forEach((sw) => { sw.style.background = window.pbColor(li.dataset.family); });\n  });\n</script>\n\n<script>\n  dash.calc('best', {\n    inputs: ['results'],\n    title: '各任务最高分',\n    description: '每个任务中得分最高的方法（不含未微调的基座），并列时一起列出。',\n    fn: (results) => ['commonsense', 'math'].map((task) => {\n      const rs = results.filter((r) => r.task === task && r.method !== 'base');\n      const top = Math.max(...rs.map((r) => r.score));\n      const win = rs.filter((r) => r.score === top);\n      return { task, score: top, method_label: win.map((r) => r.method_label).join(' / '), trainable_pct: win[0].trainable_pct };\n    }),\n  });\n\n  dash.calc('wide', {\n    inputs: ['results'],\n    title: '按方法汇总',\n    description: '把两个任务的得分、显存和训练时间并到每个方法一行。',\n    fn: (results) => {\n      const by = {};\n      results.forEach((r) => {\n        const o = (by[r.method] ??= { method: r.method, method_label: r.method_label, family: r.family, trainable_m: r.trainable_m, trainable_pct: r.trainable_pct, lr: r.lr });\n        const p = r.task === 'commonsense' ? 'cs' : 'math';\n        o[p + '_score'] = r.score;\n        o[p + '_mem'] = r.peak_mem_gb;\n        o[p + '_min'] = r.train_min;\n      });\n      return Object.values(by);\n    },\n  });\n\n  dash.calc('facts', {\n    inputs: ['results'],\n    title: '正文引用的对比数字',\n    description: '由结果表算出的差值、倍数和区间，供“主要发现”引用。',\n    fn: (results) => {\n      const g = (t, m, k) => { const r = results.find((x) => x.task === t && x.method === m); return r ? r[k] : null; };\n      const top = ['lora', 'dora', 'rslora', 'qlora', 'oft'];\n      const cs = top.map((m) => g('commonsense', m, 'score'));\n      const mt = top.map((m) => g('math', m, 'score'));\n      return [{\n        top_cs_min: Math.min(...cs), top_cs_max: Math.max(...cs),\n        top_math_min: Math.min(...mt), top_math_max: Math.max(...mt),\n        lora_gain_cs: g('commonsense', 'lora', 'score') - g('commonsense', 'base', 'score'),\n        lora_gain_math: g('math', 'lora', 'score') - g('math', 'base', 'score'),\n        dora_gain_math: g('math', 'dora', 'score') - g('math', 'lora', 'score'),\n        dora_time_cs: g('commonsense', 'dora', 'train_min') / g('commonsense', 'lora', 'train_min'),\n        dora_time_math: g('math', 'dora', 'train_min') / g('math', 'lora', 'train_min'),\n        qlora_drop_cs: g('commonsense', 'lora', 'score') - g('commonsense', 'qlora', 'score'),\n        qlora_mem_cs: g('commonsense', 'lora', 'peak_mem_gb') - g('commonsense', 'qlora', 'peak_mem_gb'),\n        qlora_mem_math: g('math', 'lora', 'peak_mem_gb') - g('math', 'qlora', 'peak_mem_gb'),\n        qlora_slow_cs: (g('commonsense', 'qlora', 'train_min') / g('commonsense', 'lora', 'train_min') - 1) * 100,\n        full_gap_cs: g('commonsense', 'lora', 'score') - g('commonsense', 'full', 'score'),\n        full_gap_math: g('math', 'lora', 'score') - g('math', 'full', 'score'),\n        full_mem_math: g('math', 'full', 'peak_mem_gb'),\n        vera_pct: g('math', 'vera', 'trainable_pct'), vera_math: g('math', 'vera', 'score'), vera_cs: g('commonsense', 'vera', 'score'),\n        ia3_math: g('math', 'ia3', 'score'), ia3_cs: g('commonsense', 'ia3', 'score'),\n        lokr_math: g('math', 'lokr', 'score'), lokr_cs: g('commonsense', 'lokr', 'score'),\n        base_math: g('math', 'base', 'score'),\n        pmlp_cs: g('commonsense', 'prefix_mlp', 'score'), pmlp_math: g('math', 'prefix_mlp', 'score'),\n        prefix_cs: g('commonsense', 'prefix', 'score'),\n        prompt_cs: g('commonsense', 'prompt', 'score'), prompt_math: g('math', 'prompt', 'score'),\n        pissa_lr: g('commonsense', 'pissa', 'lr'), lora_lr: g('commonsense', 'lora', 'lr'),\n        pissa_gap_cs: g('commonsense', 'lora', 'score') - g('commonsense', 'pissa', 'score'),\n        ada_cs: g('commonsense', 'adalora', 'score'),\n        freeze_math: g('math', 'freeze', 'score'),\n      }];\n    },\n  });\n\n  dash.draw('num', (el) => {\n    const d = dash.data(el.dataset.source);\n    el.classList.toggle('dash-skeleton', d.status === 'loading');\n    const r = window.pbPick(el);\n    el.textContent = r ? window.pbFmt(r[el.dataset.field], el.dataset.fmt) : '—';\n  });\n</script>\n\n<script>\n  // horizontal bar chart of scores per task\n  dash.draw('bars', (el) => {\n    const d = dash.data('results');\n    el.replaceChildren();\n    el.classList.toggle('dash-skeleton', d.status === 'loading');\n    if (d.status !== 'ok') { window.pbFail(el, d); return; }\n    const task = el.dataset.task;\n    const rows = d.data.filter((r) => r.task === task).sort((a, b) => b.score - a.score);\n    const base = rows.find((r) => r.method === 'base');\n    const W = Math.max(280, el.clientWidth);\n    const rowH = 22, top = 22, bottom = 26;\n    const H = top + rows.length * rowH + bottom;\n    const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('height', H);\n\n    const probe = svg.append('g');\n    let maxL = 0;\n    rows.forEach((r) => { const t = probe.append('text').text(r.method_label); maxL = Math.max(maxL, t.node().getComputedTextLength()); });\n    probe.remove();\n    const left = Math.min(maxL + 10, W * 0.45), right = 40;\n    const x = d3.scaleLinear([0, 100], [left, W - right]);\n    const y = d3.scaleBand(rows.map((r) => r.method), [top, top + rows.length * rowH]).padding(0.25);\n\n    svg.append('g').selectAll('line').data([0, 25, 50, 75, 100]).join('line')\n      .attr('x1', (v) => x(v)).attr('x2', (v) => x(v)).attr('y1', top).attr('y2', H - bottom)\n      .attr('stroke', 'var(--cds-chart-grid)').attr('stroke-width', 1);\n    svg.append('g').selectAll('text').data([0, 25, 50, 75, 100]).join('text')\n      .attr('x', (v) => x(v)).attr('y', H - bottom + 16).attr('text-anchor', 'middle').text((v) => v);\n\n    const tip = window.pbTip(el);\n    const g = svg.append('g').selectAll('g').data(rows).join('g');\n    g.append('rect').attr('x', left).attr('y', (r) => y(r.method)).attr('height', y.bandwidth())\n      .attr('width', (r) => Math.max(0, x(r.score) - left)).attr('rx', 2)\n      .style('fill', (r) => window.pbColor(r.family));\n    g.append('text').attr('class', 'pb-lbl').attr('x', left - 8).attr('y', (r) => y(r.method) + y.bandwidth() / 2)\n      .attr('dy', '0.32em').attr('text-anchor', 'end').text((r) => r.method_label);\n    g.append('text').attr('x', (r) => x(r.score) + 5).attr('y', (r) => y(r.method) + y.bandwidth() / 2)\n      .attr('dy', '0.32em').text((r) => window.pbFmt(r.score, 2));\n    g.append('rect').attr('x', 0).attr('y', (r) => y(r.method) - 2).attr('width', W).attr('height', y.bandwidth() + 4)\n      .attr('fill', 'transparent')\n      .on('mousemove', (ev, r) => { const [mx, my] = d3.pointer(ev, el); tip.show(r.method_label, window.pbTipLines(r), mx, my); })\n      .on('mouseleave', () => tip.hide());\n\n    if (base) {\n      svg.append('line').attr('x1', x(base.score)).attr('x2', x(base.score)).attr('y1', top - 6).attr('y2', H - bottom)\n        .attr('stroke', 'var(--cds-chart-reference)').attr('stroke-width', 1).attr('stroke-dasharray', '4 3').attr('pointer-events', 'none');\n      svg.append('text').attr('x', x(base.score)).attr('y', top - 10).attr('text-anchor', 'middle')\n        .text('基座 ' + window.pbFmt(base.score, 1));\n    }\n  });\n</script>\n\n<script>\n  // scatter: trainable parameters (log) vs score\n  const SHORT = { full: 'Full FT', freeze: 'Freeze', lora: 'LoRA', dora: 'DoRA', adalora: 'AdaLoRA', vera: 'VeRA', ia3: 'IA³',\n    prefix_mlp: 'Prefix (MLP)', prefix: 'P-Tuning v2', prompt: 'Prompt', oft: 'OFT', lokr: 'LoKr' };\n  dash.draw('scatter', (el) => {\n    const d = dash.data('results');\n    el.replaceChildren();\n    el.classList.toggle('dash-skeleton', d.status === 'loading');\n    if (d.status !== 'ok') { window.pbFail(el, d); return; }\n    const task = el.dataset.task;\n    const all = d.data.filter((r) => r.task === task);\n    const base = all.find((r) => r.method === 'base');\n    const rows = all.filter((r) => r.trainable_m > 0);\n    const W = Math.max(280, el.clientWidth), H = 330;\n    const m = { top: 14, right: 16, bottom: 40, left: 40 };\n    const lo = Math.floor((Math.min(...rows.map((r) => r.score), base ? base.score : 100) - 5) / 10) * 10;\n    const hi = Math.min(100, Math.ceil((Math.max(...rows.map((r) => r.score)) + 4) / 10) * 10);\n    const x = d3.scaleLog([0.02, 4000], [m.left, W - m.right]);\n    const y = d3.scaleLinear([lo, hi], [H - m.bottom, m.top]);\n    const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('height', H);\n\n    const xt = [0.1, 1, 10, 100, 1000];\n    const yt = y.ticks(5);\n    svg.append('g').selectAll('line').data(yt).join('line').attr('x1', m.left).attr('x2', W - m.right)\n      .attr('y1', (v) => y(v)).attr('y2', (v) => y(v)).attr('stroke', 'var(--cds-chart-grid)');\n    svg.append('g').selectAll('text').data(yt).join('text').attr('x', m.left - 6).attr('y', (v) => y(v))\n      .attr('dy', '0.32em').attr('text-anchor', 'end').text((v) => v);\n    svg.append('g').selectAll('line').data(xt).join('line').attr('x1', (v) => x(v)).attr('x2', (v) => x(v))\n      .attr('y1', m.top).attr('y2', H - m.bottom).attr('stroke', 'var(--cds-chart-grid)');\n    svg.append('g').selectAll('text').data(xt).join('text').attr('x', (v) => x(v)).attr('y', H - m.bottom + 15)\n      .attr('text-anchor', 'middle').text((v) => (v >= 1 ? d3.format(',')(v) : v) + 'M');\n    svg.append('text').attr('x', (m.left + W - m.right) / 2).attr('y', H - 6).attr('text-anchor', 'middle').text('可训练参数（对数刻度）');\n\n    if (base) {\n      svg.append('line').attr('x1', m.left).attr('x2', W - m.right).attr('y1', y(base.score)).attr('y2', y(base.score))\n        .attr('stroke', 'var(--cds-chart-reference)').attr('stroke-dasharray', '4 3');\n      svg.append('text').attr('x', W - m.right).attr('y', y(base.score) - 5).attr('text-anchor', 'end').text('基座 ' + window.pbFmt(base.score, 1));\n    }\n\n    const tip = window.pbTip(el);\n    svg.append('g').selectAll('circle').data(rows).join('circle')\n      .attr('cx', (r) => x(r.trainable_m)).attr('cy', (r) => y(r.score)).attr('r', 5)\n      .style('fill', (r) => window.pbColor(r.family)).attr('stroke', 'var(--color-panel)').attr('stroke-width', 1.5)\n      .on('mousemove', (ev, r) => {\n        const near = rows.filter((o) => Math.abs(x(o.trainable_m) - x(r.trainable_m)) < 4 && Math.abs(y(o.score) - y(r.score)) < 10);\n        const [mx, my] = d3.pointer(ev, el);\n        tip.show(near.map((o) => o.method_label).join(' / '), window.pbTipLines(r), mx, my);\n      })\n      .on('mouseleave', () => tip.hide());\n\n    // direct labels, nudged apart vertically when they would overlap\n    const labs = rows.filter((r) => SHORT[r.method]).map((r) => ({ r, x: x(r.trainable_m) + 8, y: y(r.score) }));\n    const g = svg.append('g');\n    labs.forEach((l) => { l.node = g.append('text').attr('class', 'pb-lbl').text(SHORT[l.r.method]).node(); l.w = l.node.getComputedTextLength(); });\n    labs.forEach((l) => { if (l.x + l.w > W - m.right) l.x = x(l.r.trainable_m) - 8 - l.w; });\n    labs.sort((a, b) => a.y - b.y);\n    for (let i = 0; i < labs.length; i++) {\n      for (let j = 0; j < i; j++) {\n        const a = labs[j], b = labs[i];\n        const overlapX = a.x < b.x + b.w && b.x < a.x + a.w;\n        if (overlapX && b.y - a.y < 12) b.y = a.y + 12;\n      }\n    }\n    labs.forEach((l) => d3.select(l.node).attr('x', l.x).attr('y', l.y).attr('dy', '0.32em'));\n  });\n</script>\n\n<script>\n  // summary table with sorting\n  window.pbSort = { key: 'cs_score', dir: -1 };\n  const NUMERIC = new Set(['trainable_m', 'trainable_pct', 'lr', 'cs_score', 'math_score', 'cs_mem', 'math_mem', 'cs_min', 'math_min']);\n  dash.draw('wide-body', (tb) => {\n    const d = dash.data('wide');\n    tb.replaceChildren();\n    if (d.status !== 'ok') return;\n    const { key, dir } = window.pbSort;\n    const rows = [...d.data].sort((a, b) => {\n      const va = a[key], vb = b[key];\n      if (va == null && vb == null) return 0;\n      if (va == null) return 1;\n      if (vb == null) return -1;\n      return NUMERIC.has(key) ? (va - vb) * dir : String(va).localeCompare(String(vb), 'zh') * dir;\n    });\n    const maxMem = Math.max(...d.data.map((r) => Math.max(r.cs_mem ?? 0, r.math_mem ?? 0)));\n    const maxMin = Math.max(...d.data.map((r) => Math.max(r.cs_min ?? 0, r.math_min ?? 0)));\n    const cols = [\n      ['method_label', 'text'], ['family', 'text', 'pb-left pb-sec'], ['trainable_m', 2], ['trainable_pct', 3, 'pb-sec'], ['lr', 'exp', 'pb-sec'],\n      ['cs_score', 2, '', 100], ['math_score', 2, '', 100], ['cs_mem', 1, 'pb-sec', maxMem], ['math_mem', 1, '', maxMem],\n      ['cs_min', 1, 'pb-sec', maxMin], ['math_min', 1, 'pb-sec', maxMin],\n    ];\n    rows.forEach((r) => {\n      const tr = document.createElement('tr');\n      tr.dataset.key = r.method;\n      cols.forEach(([k, f, cls, scale]) => {\n        const td = document.createElement('td');\n        if (cls) td.className = cls;\n        const v = r[k];\n        const span = document.createElement('span');\n        span.textContent = k === 'trainable_m' && v === 0 ? '0' : window.pbFmt(v, f);\n        if (scale && v != null) {\n          td.classList.add('pb-bar');\n          td.style.setProperty('--w', String(Math.max(0, Math.min(1, v / scale))));\n          td.style.setProperty('--bar-c', window.pbColor(r.family));\n        }\n        td.append(span);\n        tr.append(td);\n      });\n      tb.append(tr);\n    });\n  });\n  document.querySelectorAll('.pb-sort').forEach((btn) => {\n    btn.addEventListener('click', () => {\n      const k = btn.dataset.key;\n      window.pbSort = { key: k, dir: window.pbSort.key === k ? -window.pbSort.dir : (NUMERIC.has(k) ? -1 : 1) };\n      document.querySelectorAll('.pb-sort').forEach((b) => {\n        const th = b.closest('th');\n        if (!th) return;\n        if (b.dataset.key === window.pbSort.key) th.setAttribute('aria-sort', window.pbSort.dir < 0 ? 'descending' : 'ascending');\n        else th.removeAttribute('aria-sort');\n      });\n      dash.draw('wide-body');\n    });\n  });\n</script>\n\n<script>\n  // commonsense per-task heat table and setup table\n  const TESTS = ['BoolQ', 'PIQA', 'SIQA', 'HellaSwag', 'WinoGrande', 'ARC-e', 'ARC-c', 'OBQA', 'avg'];\n  dash.draw('heat-body', (tb) => {\n    const d = dash.data('cs_detail');\n    tb.replaceChildren();\n    if (d.status !== 'ok') return;\n    const rows = [...d.data].sort((a, b) => b.avg - a.avg);\n    const ext = Object.fromEntries(TESTS.map((t) => [t, d3.extent(rows, (r) => r[t])]));\n    rows.forEach((r) => {\n      const tr = document.createElement('tr');\n      tr.dataset.key = r.method;\n      const name = document.createElement('td');\n      name.textContent = r.method_label;\n      tr.append(name);\n      TESTS.forEach((t) => {\n        const td = document.createElement('td');\n        td.textContent = window.pbFmt(r[t], 1);\n        const [lo, hi] = ext[t];\n        const k = hi > lo ? (r[t] - lo) / (hi - lo) : 0;\n        td.style.background = `color-mix(in srgb, ${dash.colors[0]} ${Math.round(k * 45)}%, transparent)`;\n        if (t === 'avg') td.style.fontWeight = '600';\n        tr.append(td);\n      });\n      tb.append(tr);\n    });\n  });\n\n  dash.draw('setup-body', (tb) => {\n    const d = dash.data('setup');\n    tb.replaceChildren();\n    if (d.status !== 'ok') return;\n    d.data.forEach((r) => {\n      const tr = document.createElement('tr');\n      tr.dataset.key = r.item;\n      const a = document.createElement('td');\n      a.textContent = r.item;\n      const b = document.createElement('td');\n      b.className = 'pb-left';\n      b.style.whiteSpace = 'normal';\n      b.textContent = r.value;\n      tr.append(a, b);\n      tb.append(tr);\n    });\n  });\n</script>\n"}